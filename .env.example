# ============================================================
# ERP WR Consórcio — variáveis de ambiente
# Copie para .env (desenvolvimento) e configure na Vercel (produção).
# NUNCA commite .env com segredos reais.
# ============================================================

# Conexão usada pela aplicação. Na Supabase: string do POOLER (porta 6543, transaction mode),
# com ?pgbouncer=true&connection_limit=1 para funções serverless.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta, usada só pelas migrations (prisma migrate deploy). Na Supabase: porta 5432.
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# Segredo de assinatura do JWT da sessão (mínimo 32 caracteres, aleatório).
# Gere com: openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres"

# Opcional — segredo da rota de cron que processa a fila de recálculo (/cron/fila).
# A Vercel envia "Authorization: Bearer <CRON_SECRET>" automaticamente.
CRON_SECRET=""

# Opcional — só para o seed: data de início da vigência da carga inicial (AAAA-MM-DD).
# Padrão 2026-09-01 (percentuais da especificação são de setembro/2026).
# CARGA_VIGENCIA_INICIO="2026-09-01"

# Opcional — só para o script de primeiro administrador (npm run db:criar-admin).
# ADMIN_EMAIL="" ADMIN_NOME="" ADMIN_SENHA=""
